# RailBlock Advisor Backend Environment Variables

# Frontend URL for CORS configuration (supports comma-separated list for multiple domains)
# Local: http://localhost:5173, http://localhost:4173
# Production (Render Environment Variable): https://railblock-advisor-frontend.vercel.app
FRONTEND_ORIGIN=https://railblock-advisor-frontend.vercel.app,http://localhost:5173,http://localhost:4173


# Uvicorn server host and port
HOST=0.0.0.0
PORT=8000

# Set to true only in development to allow all CORS origins
CORS_ALLOW_ALL=false

